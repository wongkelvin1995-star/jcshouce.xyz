{{ printf `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}
<rss version="2.0"><channel><title>{{ .Site.Title }}</title><link>{{ .Site.Home.Permalink }}</link><description>{{ .Site.Home.Description }}</description><language>zh-CN</language>{{ range .Site.RegularPages.ByDate.Reverse }}{{ if not .Params.noindex }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Description }}</description></item>{{ end }}{{ end }}</channel></rss>
